# Copy to .env and fill in your real key. .env is gitignored.
# Variable name confirmed against typesafe-sdk 0.7.0 (constants.API_KEY_ENV).
TYPESAFE_API_KEY=

# Optional overrides; the SDK defaults to jev-latest and https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
